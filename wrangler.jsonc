{
  // Cloudflare Workers static-assets deploy. `npm run build` writes the site to dist/.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dynasties-bukidnon",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  // Required by `npx wrangler preview`, which Workers Builds runs for non-production branches
  "previews": {},
  // Home: officials.betterbukidnon.org. The first address, dynasties.betterbukidnon.org, should
  // 301 to it through a Cloudflare redirect rule (set in the dashboard, not here).
  "routes": [{ "pattern": "officials.betterbukidnon.org", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true
}
